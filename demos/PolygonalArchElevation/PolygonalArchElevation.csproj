<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PolygonalArchElevation</AssemblyName>
    <RootNamespace>Frahan.Demos.PolygonalArchElevation</RootNamespace>
  </PropertyGroup>

  <!-- Clipper2 does the opening cut. The polygonal wall is a PLANAR set of
       cells, so subtracting an opening is a 2D boolean - the 3D CGAL difference
       used by examples/27_10 is only needed when the cut is not prismatic. -->
  <ItemGroup>
    <PackageReference Include="Clipper2" Version="2.0.0" />
  </ItemGroup>

  <!-- Links the REAL shipping sources (never copies), same pattern as the
       structural-stone demo: both walls in the comparison are generated and
       analysed by the code that ships. -->
  <ItemGroup>
    <Compile Include="../../src/Frahan.StonePack.Core/Masonry/Sequencing/PolygonalWallGenerator.cs" Link="Src/PolygonalWallGenerator.cs" />
    <Compile Include="../../src/Frahan.StonePack.Core/Masonry/Geometry/Clipper2Adapter.cs" Link="Src/Clipper2Adapter.cs" />
    <Compile Include="../../src/Frahan.StonePack.Core/Masonry/DataModel/MasonryAssembly.cs" Link="Src/MasonryAssembly.cs" />
