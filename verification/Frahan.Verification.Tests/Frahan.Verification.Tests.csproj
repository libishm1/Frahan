<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Frahan.Verification.Tests — the permanent Layer-1 verification suite.
    Consolidates the six ad-hoc harnesses (outputs/2026-07-24/*_verification)
    into one CI-runnable xUnit project.

    Philosophy: LINK the real shipping source, never copy kernel code. Each
    <Compile Include> below points at the actual file under src/; a bug fixed
    in src/ is immediately re-verified here. Paths are RELATIVE (../../src/...)
    so the project restores and tests on the CI runner (ubuntu) exactly as it
    does locally — the original harnesses used absolute D:\ paths and were not
    portable. The only local code is the two tiny stubs under Stubs/ (unused
    return types the kernels reference but the tests never exercise) and the
    test classes themselves.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Override the repo-root Directory.Build.props (Nullable=enable,
         LangVersion=10.0): the linked kernels + harness logic were authored
         and verified under these settings. -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>Frahan.Verification.Tests</AssemblyName>
    <RootNamespace>Frahan.Verification.Tests</RootNamespace>
    <!-- The suite intentionally overrides the release version props from
         Directory.Build.props via Nullable/LangVersion above; no unsafe code
         is used by any linked kernel. -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Test + property-based-testing + geometry NuGets. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="CsCheck" Version="4.7.0" />
    <PackageReference Include="Clipper2" Version="2.0.0" />
    <PackageReference Include="Rhino3dm" Version="8.*" />
    <!-- Soft-ICP kernel dependency. EXACT pin [4.15.0] mirrors the
         Frahan.EdgeMatching.Core.csproj: 4.15.x is the last MathNet line
         targeting net48; its netstandard2.0 assembly also loads on net8.0, so
         SoftIcpRefiner (3x3 SVD weighted Kabsch) and SoftIcpLbfgs
         (BfgsMinimizer) link unchanged. -->
    <PackageReference Include="MathNet.Numerics" Version="[4.15.0]" />
  </ItemGroup>

  <!-- ================= REAL shipping sources (link, do not copy) ============ -->

