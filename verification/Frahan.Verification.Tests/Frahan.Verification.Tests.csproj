  <!-- Soft-ICP CPD/EM pose refiner (SoftIcpTests). The kernels live in the
       SIBLING project Frahan.EdgeMatching.Core (namespace Frahan.EdgeMatching),
       so these link via ../../src/Frahan.EdgeMatching.Core/... . SoftIcpRefiner
       is the production EM weighted-Kabsch alternation; SoftIcpLbfgs is the
       gradient-descent (MathNet BfgsMinimizer) sibling. Both reference
       RhinoCommon-native Mesh.IsPointInside / Mesh.ClosestPoint / Curve.Contains
       in their penetration term ONLY; those symbols are supplied compile-only by
       Stubs/RhinoCommonPenetrationShims.cs and never invoked (tests run with
       Solid=null / Contour2D=null so only the CPD contact + Kabsch path runs).
       SpatialHash3D (E-step neighbour query) and LieGroups (DampDelta so(3) Exp)
       are the two internal helpers the refiner calls. -->
  <ItemGroup>
    <Compile Include="../../src/Frahan.EdgeMatching.Core/SoftIcpRefiner.cs">
      <Link>Linked/EdgeMatching/SoftIcpRefiner.cs</Link>
    </Compile>
    <Compile Include="../../src/Frahan.EdgeMatching.Core/SoftIcpOptions.cs">
      <Link>Linked/EdgeMatching/SoftIcpOptions.cs</Link>
